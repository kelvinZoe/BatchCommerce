{
  "name": "shakhis-commerce",
  "version": "1.0.0",
  "description": "Shakhis Ventures Commerce Desktop App",
  "main": "electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4300",
    "start:web": "npx serve -s dist/shakhis-commerce -l 4300",
    "build": "node ./scripts/generate-env.js && ng build --configuration production",
    "build:web": "npm run build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "npm run build && electron .",
    "dev:electron": "concurrently \"npm start --prefix ../server\" \"ng serve --port 4300\" \"wait-on http://localhost:3001 http://localhost:4300 && NODE_ENV=development electron .\"",
    "electron:dev": "concurrently \"npm start --prefix ../server\" \"ng serve --port 4300\" \"wait-on http://localhost:3001 http://localhost:4300 && NODE_ENV=development electron .\"",
    "start:electron": "npm run electron:dev",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:all": "npm run build && electron-builder --mac --win --linux"
  },
  "author": "Shakhis Ventures",
  "license": "MIT",
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/router": "^17.0.0",
    "@ng-bootstrap/ng-bootstrap": "^16.0.0",
    "@supabase/supabase-js": "^2.95.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "~5.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.shakhis.commerce",
    "productName": "Shakhis Commerce",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
