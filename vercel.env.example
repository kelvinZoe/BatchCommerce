# Vercel environment variables (copy into Vercel dashboard)
# Do NOT commit real secrets. Set these in Vercel Project > Settings > Environment Variables.

# URL of your Supabase project (e.g. https://<project>.supabase.co)
SUPABASE_URL=

# Supabase anon/public API key (publishable)
SUPABASE_KEY=

# Backend admin API URL (deployed server/index.js)
ADMIN_API_URL=
