# Copy to .env and fill values
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Choose a strong secret to protect this admin endpoint. Keep it safe and do NOT commit.
ADMIN_API_SECRET=choose_a_strong_secret_here
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Shakhis Commerce <onboarding@resend.dev>
APP_BASE_URL=https://batchcommerce.vercel.app
# In production, this must be your public frontend URL (never localhost)
# Optional explicit callback URL override for verification links.
# If set, invite links always redirect to this callback path.
AUTH_CALLBACK_URL=https://batchcommerce.vercel.app/auth/callback
# Backward compatible alias for EMAIL_FROM
RESEND_FROM_EMAIL=Shakhis Commerce <no-reply@your-domain.com>
PORT=3000
# Gmail (primary email sender via Nodemailer — generate App Password in Google Account settings)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
