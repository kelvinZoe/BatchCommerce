# Copy to .env and fill values
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=BatchCommerce Support <support@pharma-uci.com>
# Must be a publicly accessible HTTPS image; email clients cannot load localhost.
EMAIL_LOGO_URL=https://batchcommerce.vercel.app/assets/BatchCommerce.png
APP_BASE_URL=https://batchcommerce.vercel.app
# Comma-separated frontend origins allowed to call this API.
ADMIN_API_ALLOWED_ORIGINS=https://batchcommerce.vercel.app
# In production, this must be your public frontend URL (never localhost)
# Optional explicit callback URL override for verification links.
# If set, invite links always redirect to this callback path.
AUTH_CALLBACK_URL=https://batchcommerce.vercel.app/auth/callback
# All application emails are sent from the fixed BatchCommerce support sender.
RESEND_FROM_EMAIL=BatchCommerce Support <support@pharma-uci.com>
PORT=3000
