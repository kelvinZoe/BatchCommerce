NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Generate an independent value with: openssl rand -hex 32
RATE_LIMIT_HMAC_SECRET=replace_with_at_least_32_random_characters

# Sender is fixed in server code as BatchCommerce Support <support@pharma-uci.com>.
RESEND_API_KEY=re_your_key
EMAIL_LOGO_URL=https://your-next-domain.example/assets/BatchCommerce.png
APP_BASE_URL=https://your-next-domain.example
